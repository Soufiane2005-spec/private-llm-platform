# Application
APP_NAME=private-llm-platform
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Database
DATABASE_URL=

# Redis
REDIS_URL=

# LLM engines
OLLAMA_IMAGE=ollama/ollama:0.32.14
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120

# Monitoring
PROMETHEUS_BASE_URL=http://monitoring-kube-prometheus-prometheus.monitoring:9090

# Model runtime
MODEL_DEPLOYMENT_BACKEND=local
KUBERNETES_NAMESPACE=llm-platform
MODEL_OPERATION_TIMEOUT_SECONDS=120

# vLLM
VLLM_IMAGE=vllm/vllm-openai:v0.27.0
VLLM_PORT=8000
VLLM_BASE_URL=http://vllm:8000
VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_SERVED_MODEL_NAME=qwen3-0.6b
VLLM_DTYPE=half
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=1024
VLLM_MAX_NUM_SEQS=1
VLLM_LOGGING_LEVEL=INFO
HF_TOKEN=
VLLM_USE_V2_MODEL_RUNNER=0

# Security
AUTH_SECRET_KEY=
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_ROLE=admin
AUTH_ADMIN_PASSWORD_HASH=
